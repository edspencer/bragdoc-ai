# Keep the build context small and deterministic: node_modules and dist are rebuilt inside the image, and nothing
# else here is part of the build. .git is left out too, so the release workflow passes the commit in as a build arg
# (scripts/build-info.mjs).
**/node_modules
dist
.git
.github
.changeset
e2e
test
test-results
playwright-report
website
tasks
qa
.qa
.playwright-mcp
src/routeTree.gen.ts
*.log
*.tgz
.DS_Store
.env
.env.*
CLAUDE.local.md
