{
  "name": "@bragdoc/local",
  "version": "0.0.0",
  "description": "A local-first, open-source tracker for the things you've done at work: your achievements and the evidence for them, kept as plain files on your own machine.",
  "keywords": [
    "brag-document",
    "achievements",
    "performance-review",
    "career",
    "local-first",
    "mcp",
    "claude-code"
  ],
  "homepage": "https://github.com/edspencer/bragdoc-ai#readme",
  "bugs": {
    "url": "https://github.com/edspencer/bragdoc-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edspencer/bragdoc-ai.git"
  },
  "license": "MIT",
  "author": "Ed Spencer",
  "type": "module",
  "bin": {
    "bragdoc": "dist/server/cli.js"
  },
  "files": [
    "dist/server/",
    "dist/shared/",
    "dist/web/",
    "AGENT-GUIDE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node -e \"fs.rmSync('dist/server',{recursive:true,force:true});fs.rmSync('dist/shared',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "routes": "tsr generate",
    "typecheck": "tsr generate && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "bragdoc": "tsx server/cli.ts",
    "check:nul": "node scripts/check-no-nul-bytes.mjs",
    "prepack": "npm run build",
    "brand": "node brand/generate.mjs",
    "docs:media": "tsx tools/docs-media/capture.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-cli": "^1.167.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
