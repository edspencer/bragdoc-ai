{
  "name": "@bragdoc/local",
  "version": "0.0.0",
  "description": "A local-first, open-source tracker for the things you've done at work: your achievements and the evidence for them, kept as plain files on your own machine.",
  "keywords": [
    "brag-document",
    "achievements",
    "performance-review",
    "career",
    "local-first",
    "mcp",
    "claude-code"
  ],
  "homepage": "https://github.com/edspencer/bragdoc-ai#readme",
  "bugs": {
    "url": "https://github.com/edspencer/bragdoc-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edspencer/bragdoc-ai.git"
  },
  "license": "MIT",
  "author": "Ed Spencer",
  "type": "module",
  "bin": {
    "bragdoc": "dist/server/cli.js"
  },
  "files": [
    "dist/server/",
    "dist/shared/",
    "dist/web/",
    "dist/build-info.json",
    "fixtures/example/",
    "AGENT-GUIDE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server && node scripts/strip-maps.mjs && node scripts/build-info.mjs",
    "build:web": "vite build",
    "build:server": "node -e \"fs.rmSync('dist/server',{recursive:true,force:true});fs.rmSync('dist/shared',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "routes": "tsr generate",
    "typecheck": "tsr generate && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "bragdoc": "tsx server/cli.ts",
    "check:nul": "node scripts/check-no-nul-bytes.mjs",
    "prepack": "npm run build",
    "brand": "node brand/generate.mjs",
    "docs:media": "tsx tools/docs-media/capture.ts",
    "docs:media:sync": "tsx tools/docs-media/sync.ts",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/whats-new-release.mjs && npm install --package-lock-only --ignore-scripts",
    "sync:reference": "tsx scripts/sync-reference.ts",
    "store:demo": "tsx scripts/store-demo.ts",
    "eval:screenshots": "tsx scripts/eval-screenshots.ts",
    "gen:example": "tsx scripts/gen-example.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/server": "^2.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "chokidar": "^5.0.0",
    "file-type": "^22.2.0",
    "hono": "^4.13.13",
    "js-yaml": "^4.3.2",
    "minisearch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "~7.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-cli": "^1.167.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
